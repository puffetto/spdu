#! /bin/bash

# SPDU: probe a service and reconcile its address in a local DNS pool.
# Author: Andrea "Nemesi" Cocito. See README.md for configuration and operation.
PATH=/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin
export PATH
umask 077
set -f

fail() { printf 'spdu: ERROR: %s\n' "$1" >&2; exit 1; }
child=
runtime=
cleanup()
{
    trap - EXIT
    if [[ -n $child ]]; then
        kill -TERM "$child" 2>/dev/null
        for ((_spdu_wait=0; _spdu_wait<15; _spdu_wait++)); do
            kill -0 "$child" 2>/dev/null || break
            /bin/sleep 0.1
        done
        kill -KILL "$child" 2>/dev/null
        wait "$child" 2>/dev/null
    fi
    [[ -z $runtime ]] || rm -rf -- "$runtime"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
run()
{
    "$@" <&0 & child=$!
    wait "$child"
    local result=$?
    child=
    return "$result"
}

# Resolve once, then source only a root-owned path with protected ancestors.
# Refuse nontrivial ACLs as well as POSIX group/other write permissions.
safeSource()
{
    local _spdu_file=$1 _spdu_path _spdu_metadata _spdu_uid _spdu_mode _spdu_permissions
    [[ -e $_spdu_file || -L $_spdu_file ]] || return 0
    _spdu_path=$(/bin/realpath "$_spdu_file") || fail "Cannot resolve configuration: $_spdu_file"
    [[ -f $_spdu_path && -r $_spdu_path ]] || fail "Unreadable/nonregular configuration: $_spdu_file"
    _spdu_file=$_spdu_path
    while :; do
        _spdu_metadata=$(/usr/bin/stat -L -f '%u %Lp' "$_spdu_path") || fail "Cannot inspect configuration path: $_spdu_path"
        read -r _spdu_uid _spdu_mode <<< "$_spdu_metadata"
        [[ $_spdu_uid == 0 && $_spdu_mode =~ ^[0-7]+$ ]] || fail "Configuration path is not root-owned: $_spdu_path"
        (( (8#$_spdu_mode & 022) == 0 )) || fail "Configuration path is writable by others: $_spdu_path"
        _spdu_permissions=$(LC_ALL=C /bin/ls -ld "$_spdu_path") || fail "Cannot inspect ACL: $_spdu_path"
        _spdu_permissions=${_spdu_permissions%% *}
        [[ $_spdu_permissions != *+* ]] || fail "Nontrivial configuration ACL: $_spdu_path"
        [[ $_spdu_path != / ]] || break
        _spdu_path=${_spdu_path%/*}; [[ -n $_spdu_path ]] || _spdu_path=/
    done
    configFiles+=("$_spdu_file")
    # shellcheck disable=SC1090
    source "$_spdu_file"
}
integer()
{
    local value=${!1}
    [[ $value =~ ^[1-9][0-9]*$ && ${#value} -le 10 ]] || fail "Invalid positive integer: $1"
    (( value <= $2 )) || fail "Out-of-range integer: $1"
}
decimal()
{
    local value=${!1}
    [[ $value =~ ^(0|[1-9][0-9]*)(\.[0-9]+)?$ && ${#value} -le 12 ]] || fail "Invalid decimal timeout: $1"
    [[ ! $value =~ ^0(\.0+)?$ ]] || fail "Timeout must be greater than zero: $1"
    [[ ${value%%.*} -lt 3600 || $value =~ ^3600(\.0+)?$ ]] || fail "Timeout exceeds 3600 seconds: $1"
}
boolean()
{
    [[ ${!1} =~ ^([yY]([eE][sS])?|[nN][oO]?)$ ]] || fail "Invalid yes/no setting: $1"
}
commandWords()
{
    # Legacy command overrides may contain whitespace-separated arguments,
    # not shell quoting or executable shell text. Globbing stays disabled.
    local IFS=$' \t\n'
    read -r -d '' -a words <<< "$1" || :
    [[ ${#words[@]} -gt 0 ]] || fail 'Empty command override'
    command -v "${words[0]}" >/dev/null || fail "Missing command: ${words[0]}"
}

checkOnly=no
if [[ ${1:-} == --check ]]; then checkOnly=yes; shift; fi
[[ $# -le 1 ]] || fail 'Usage: spdu [--check] [target]'
if [[ -n ${1:-} ]]; then
    [[ $1 =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || fail 'Invalid target argument'
fi
configFiles=()
safeSource /usr/local/etc/spdu.conf
[[ -z ${1:-} ]] || safeSource "/usr/local/etc/spdu/$1"
zoneExplicit=no; [[ ! -v poolZone ]] || zoneExplicit=yes

: "${domain=$(/bin/hostname -d)}" "${nameServer=127.0.0.1}" "${nameTTL=5}"
: "${mailTo=}" "${myTag=$(/bin/hostname -s)}" "${apiDomain=$domain}" "${apiName=api}"
: "${probePath=status}" "${probeTimeout=3.0}" "${loopWait=2}" "${probeSSL=no}" "${probeRetries=5}"
: "${poolDomain=$domain}" "${poolZone=pool}" "${poolName=api}" "${targetName=${1:-}}" "${targetDomain=$domain}"
: "${dnsTimeout=5}" "${dnsRefresh=60}" "${smtpTimeout=5}" "${smtpConnectTimeout=2}" "${mailInterval=60}"
: "${curl=/usr/local/bin/curl}" "${nsupdate=/usr/local/bin/knsupdate}" "${dig=/usr/local/bin/kdig}"
fqdnrx='^([a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?\.)+[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?$'
iprx='^(([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\.){3}([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])$'
mailrx="^[a-zA-Z0-9.!#$%&'*+/=?^_\`{|}~-]+@[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]*[a-zA-Z0-9])?)+$"
[[ $nameServer =~ $iprx ]] || fail 'nameServer must be an IPv4 address'
[[ -n $targetName || -n ${poolTargets:-} ]] || fail 'Target not specified'
[[ -n $targetName ]] || targetName=$poolName
[[ $targetName == *.* ]] || targetName+=.$targetDomain
[[ $apiName == *.* ]] || apiName+=.$apiDomain
[[ $poolZone == *.* ]] || poolZone+=.$poolDomain
if [[ $poolName != *.* ]]; then poolName+=.$poolZone
elif [[ $zoneExplicit == no ]]; then poolZone=${poolName#*.}; fi
for name in targetName apiName poolName poolZone; do
    value=${!name}
    [[ $value =~ $fqdnrx && ${#value} -le 253 ]] || fail "Invalid hostname: $name"
done
[[ $poolName == "$poolZone" || $poolName == *."$poolZone" ]] || fail 'poolName is outside poolZone'
[[ $probePath != *$'\r'* && $probePath != *$'\n'* ]] || fail 'Invalid probePath'
integer loopWait 86400; integer probeRetries 100; integer nameTTL 2147483647
integer dnsRefresh 86400
decimal probeTimeout; integer dnsTimeout 3600
boolean probeSSL
probeScheme=http; defaultProbePort=80
[[ ! $probeSSL =~ ^[yY] ]] || { probeScheme=https; defaultProbePort=443; }
: "${probePort=$defaultProbePort}"
integer probePort 65535
probeURI="$probeScheme://$apiName:$probePort/$probePath"
commandWords "$curl"; curlCommand=("${words[0]}" --disable "${words[@]:1}")
commandWords "$nsupdate"; updateCommand=("${words[@]}")
commandWords "${sleep:-/bin/sleep}"; sleepCommand=("${words[@]}")
timeoutCommand=/bin/timeout
[[ -x $timeoutCommand ]] || timeoutCommand=/usr/bin/timeout
for tool in "$timeoutCommand" /bin/date /usr/bin/mktemp /bin/realpath /usr/bin/stat /bin/ls /bin/hostname; do
    [[ -x $tool ]] || fail "Missing required tool: $tool"
done
poolMode=no
probeNames=(); probeIPs=()
if [[ -n ${poolTargets:-} ]]; then
    poolMode=yes
    [[ ! -v targetIP ]] || fail 'poolTargets and targetIP are mutually exclusive'
    declare -A probeNamesSeen=() probeIPsSeen=()
    for endpoint in $poolTargets; do
        name=${endpoint%%=*}; address=${endpoint#*=}
        [[ $endpoint == *=* && $name =~ $fqdnrx && ${#name} -le 253 && $address =~ $iprx ]] || fail 'Invalid poolTargets FQDN=IPv4 pair'
        [[ -z ${probeNamesSeen[$name]+set} && -z ${probeIPsSeen[$address]+set} ]] || fail 'Duplicate poolTargets identity/address'
        probeNamesSeen[$name]=1; probeIPsSeen[$address]=1
        probeNames+=("$name"); probeIPs+=("$address")
    done
    [[ ${#probeNames[@]} -gt 0 ]] || fail 'Empty poolTargets'
fi
if [[ ! -v targetIP && $poolMode == no ]]; then commandWords "$dig"; digCommand=("${words[@]}"); fi
if [[ -v targetIP ]]; then [[ $targetIP =~ $iprx ]] || fail 'Invalid targetIP'; fi

recipients=()
IFS=$' \t\n' read -r -d '' -a recipients <<< "$mailTo" || :
if [[ ${#recipients[@]} -gt 0 ]]; then
    integer mailInterval 86400; decimal smtpTimeout; decimal smtpConnectTimeout
    for recipient in "${recipients[@]}"; do [[ $recipient =~ $mailrx ]] || fail 'Invalid mailTo address'; done
    : "${mailFrom=robot@$domain}" "${smtpRelay=smtp.$domain}" "${smtpSSL=yes}"
    [[ $mailFrom =~ $mailrx ]] || fail 'Invalid mailFrom'
    [[ $smtpRelay =~ $fqdnrx ]] || fail 'Invalid smtpRelay'
    boolean smtpSSL
    smtpScheme=smtp; smtpPortDefault=25
    [[ ! $smtpSSL =~ ^[yY] ]] || { smtpScheme=smtps; smtpPortDefault=465; }
    : "${smtpPort=$smtpPortDefault}" "${smtpUser=$mailFrom}" "${smtpPassword=}"
    integer smtpPort 65535
    [[ $smtpUser != *$'\r'* && $smtpUser != *$'\n'* && $smtpPassword != *$'\r'* && $smtpPassword != *$'\n'* ]] || fail 'SMTP credentials must not contain newlines'
    [[ $myTag != *$'\r'* && $myTag != *$'\n'* ]] || fail 'Invalid myTag'
    if [[ -n $smtpPassword ]]; then
        for file in "${configFiles[@]}"; do
            mode=$(/usr/bin/stat -f '%Lp' "$file") || fail 'Cannot inspect SMTP configuration mode'
            (( (8#$mode & 004) == 0 )) || fail 'SMTP credentials require private configuration files'
        done
    fi
    smtpURI="$smtpScheme://$smtpRelay:$smtpPort"
fi
[[ $checkOnly != yes ]] || exit 0
runtime=$(/usr/bin/mktemp -d /tmp/spdu.XXXXXXXX) || fail 'Cannot create private runtime directory'
if [[ ! -v targetIP && $poolMode == no ]]; then
    run "${digCommand[@]}" +short -t A "$targetName" > "$runtime/answers" || fail 'Cannot resolve targetIP'
    while IFS= read -r answer; do
        [[ $answer =~ $iprx ]] || continue
        targetIP=$answer; break
    done < "$runtime/answers"
    [[ -v targetIP ]] || fail 'No IPv4 target address found'
fi
if [[ $poolMode == no ]]; then
    probeNames=("$apiName"); probeIPs=("$targetIP")
fi
targetIP=${probeIPs[0]}
mapIP="$apiName:$probePort:$targetIP"
targetTag=${targetName%%.*}
if [[ ${#recipients[@]} -gt 0 && -n $smtpPassword ]]; then
    credential="$smtpUser:$smtpPassword"
    credential=${credential//\\/\\\\}; credential=${credential//\"/\\\"}
    printf 'user = "%s"\n' "$credential" > "$runtime/smtp.conf"
    unset credential smtpPassword smtpUser
fi

healthHeader()
{
    # curl dumps interim responses and trailers too: inspect only the final
    # HTTP header block, with complete/coalesced duplicates kept coherent.
    awk '
      /^HTTP\// {n=0; headers=1; previous=0; next}
      {sub(/\r$/, "")}
      /^$/ {headers=0; previous=0; next}
      !headers {next}
      /^[ \t]/ {if(previous) values[n]=values[n] " " $0; next}
      {
        previous=0; colon=index($0, ":"); if(!colon) next;
        if(tolower(substr($0,1,colon-1))!="x-spdu-health") next;
        fields=split(substr($0,colon+1), parts, ",");
        for(i=1;i<=fields;i++) values[++n]=parts[i];
        previous=1
      }
      END {
        if(!n) {print "legacy"; exit}
        invalid=0; different=0;
        for(i=1;i<=n;i++) {
          v=values[i]; sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v);
          if(v!~/^[0-9]+$/) {invalid=1; continue}
          sub(/^0+/, "", v); if(v=="") v="0";
          if(length(v)>10 || (length(v)==10 && v+0>4294967295)) {invalid=1; continue}
          if(i>1 && v+0!=first) different=1;
          if(i==1) first=v+0
        }
        if(n>1 && (invalid || different)) exit 65;
        if(invalid) print "legacy"; else printf "%.0f\n", first
      }' "$runtime/http-headers" > "$runtime/health-score"
}
probe()
{
    local attempts=$1 attempt result
    for ((attempt=1; attempt<=attempts; attempt++)); do
        run "${curlCommand[@]}" --noproxy '*' --globoff --resolve "$mapIP" \
            --ipv4 --fail --fail-early --max-time "$probeTimeout" \
            --dump-header "$runtime/http-headers" --write-out '%{http_code}' --output /dev/null "$probeURI" > "$runtime/http-code" 2>/dev/null
        result=$?
        if [[ $result == 0 && $(< "$runtime/http-code") == 200 ]]; then
            if healthHeader; then probeHealth=$(< "$runtime/health-score"); return 0; fi
            result=65
        fi
        [[ $result != 0 ]] || result=22
        if (( attempt < attempts )); then run "${sleepCommand[@]}" "$loopWait"; fi
    done
    return "$result"
}
pool()
{
    local action=add
    [[ $1 == 0 ]] || action=delete
    printf 'server %s\nzone %s\nupdate %s %s %s A %s\nsend\n' \
        "$nameServer" "$poolZone" "$action" "$poolName" "$nameTTL" "$targetIP" > "$runtime/update"
    run "$timeoutCommand" -k 1 "$dnsTimeout" "${updateCommand[@]}" -v -t "$dnsTimeout" < "$runtime/update"
}
poolSet()
{
    {
        printf 'server %s\nzone %s\nupdate delete %s A\n' "$nameServer" "$poolZone" "$poolName"
        for address in $desired; do printf 'update add %s %s A %s\n' "$poolName" "$nameTTL" "$address"; done
        printf 'send\n'
    } > "$runtime/update"
    run "$timeoutCommand" -k 1 "$dnsTimeout" "${updateCommand[@]}" -v -t "$dnsTimeout" < "$runtime/update"
}
report()
{
    local status=DOWN action=removed recipient toHeader
    printf -v toHeader '%s, ' "${recipients[@]}"
    toHeader=${toHeader%, }
    [[ $1 != 0 ]] || { status=UP; action=added; }
    {
        printf 'From: "Robot SPDU on %s" <%s>\nTo: %s\n' "$myTag" "$mailFrom" "$toHeader"
        printf 'Date: %s\nSubject: %s: Server %s is %s\n\n' "$(LC_TIME=C /bin/date -u '+%a, %d %b %Y %T %z')" "$status" "$targetTag" "$status"
        if [[ $poolMode == yes ]]; then
            printf 'SPDU on %s: pool %s is %s; selected addresses: %s.\n' "$myTag" "$poolName" "$status" "${desired:-none}"
        else
            printf 'SPDU on %s: service %s/%s is %s (probe exit %s).\n' "$myTag" "$targetName" "$targetIP" "$status" "$probeCode"
        fi
        printf 'Previous state since %s; transition at %s.\n' "$previousChange" "$lastChange"
        if [[ $poolMode == yes ]]; then
            printf 'Reconciled %s on %s to: %s.\n' "$poolName" "$nameServer" "${desired:-empty}"
        else
            printf 'Successfully %s %s in %s on %s.\n' "$action" "$targetIP" "$poolName" "$nameServer"
        fi
    } > "$runtime/mail"
    local args=(--noproxy '*' --silent --show-error --crlf
        --connect-timeout "$smtpConnectTimeout" --max-time "$smtpTimeout" --mail-from "$mailFrom" --mail-rcpt-allowfails)
    [[ ! -f $runtime/smtp.conf ]] || args+=(--config "$runtime/smtp.conf")
    for recipient in "${recipients[@]}"; do args+=(--mail-rcpt "$recipient"); done
    [[ $smtpScheme != smtps ]] || args+=(--ssl-reqd)
    run "${curlCommand[@]}" "${args[@]}" --url "$smtpURI" -T "$runtime/mail"
}

SECONDS=0
state=-1; applied=-1; lastSync=-86400; lastMail=-86400; pendingMail=no
lastChange=$(/bin/date -u '+%Y-%m-%d at %H:%M:%S UTC')
if [[ $poolMode == yes ]]; then
    probeStates=(); probeScores=()
    for ((index=0; index<${#probeNames[@]}; index++)); do probeStates[index]=-1; probeScores[index]=legacy; done
    previousDesired='?'
    while :; do
        for ((index=0; index<${#probeNames[@]}; index++)); do
            apiName=${probeNames[index]}; targetIP=${probeIPs[index]}
            mapIP="$apiName:$probePort:$targetIP"
            probeURI="$probeScheme://$apiName:$probePort/$probePath"
            attempts=$probeRetries; [[ ${probeStates[index]} != 1 ]] || attempts=1
            probe "$attempts"; probeCode=$?
            observed=1
            if [[ $probeCode == 0 ]]; then
                observed=0; [[ $probeHealth != 0 ]] || observed=1
                if [[ ${probeScores[index]} != "$probeHealth" ]]; then
                    printf 'spdu-%s: %s health %s\n' "$targetTag" "$apiName" "$probeHealth"
                fi
                probeScores[index]=$probeHealth
            fi
            if [[ ${probeStates[index]} != "$observed" ]]; then
                printf 'spdu-%s: %s probe state %s (exit %s)\n' "$targetTag" "$apiName" "$observed" "$probeCode"
            fi
            probeStates[index]=$observed
        done
        # All candidates have a bounded observation before changing persisted DNS.
        best=-1; legacy=no; desired=
        for ((index=0; index<${#probeNames[@]}; index++)); do
            [[ ${probeStates[index]} == 0 ]] || continue
            score=${probeScores[index]}
            if [[ $score == legacy ]]; then legacy=yes
            elif (( score > best )); then best=$score; fi
        done
        for ((index=0; index<${#probeNames[@]}; index++)); do
            [[ ${probeStates[index]} == 0 ]] || continue
            if [[ $legacy == yes || ${probeScores[index]} == "$best" ]]; then
                desired+="${desired:+ }${probeIPs[index]}"
            fi
        done
        if [[ $desired != "$previousDesired" ]]; then
            previousChange=$lastChange; lastChange=$(/bin/date -u '+%Y-%m-%d at %H:%M:%S UTC')
            [[ $previousDesired == '?' || ${#recipients[@]} == 0 ]] || pendingMail=yes
            previousDesired=$desired
        fi
        if [[ $applied != "$desired" ]] || (( SECONDS-lastSync >= dnsRefresh )); then
            if poolSet; then
                applied=$desired; lastSync=$SECONDS
                printf 'spdu-%s: DNS pool applied: %s\n' "$targetTag" "${desired:-empty}"
            else
                applied='?'
                printf 'spdu-%s: ERROR: DNS pool update failed; retry pending\n' "$targetTag" >&2
            fi
        fi
        state=0; [[ -n $desired ]] || state=1
        if [[ $pendingMail == yes && $applied == "$desired" ]] && (( SECONDS-lastMail >= mailInterval )); then
            if report "$state"; then pendingMail=no
            else printf 'spdu-%s: ERROR: notification failed; retry pending\n' "$targetTag" >&2; fi
            lastMail=$((SECONDS+1))
        fi
        run "${sleepCommand[@]}" "$loopWait"
    done
fi
printf 'spdu-%s: pid %s monitoring %s/%s\n' "$targetTag" "$$" "$targetName" "$targetIP"
while :; do
    attempts=$probeRetries; [[ $state != 1 ]] || attempts=1
    probe "$attempts"; probeCode=$?
    observed=1; [[ $probeCode != 0 ]] || observed=0
    if [[ $probeCode == 0 && $probeHealth == 0 ]]; then observed=1; fi
    if [[ $observed != "$state" ]]; then
        previousChange=$lastChange
        lastChange=$(/bin/date -u '+%Y-%m-%d at %H:%M:%S UTC')
        [[ $state == -1 || ${#recipients[@]} == 0 ]] || pendingMail=yes
        state=$observed
        label=UP; [[ $state == 0 ]] || label=DOWN
        printf 'spdu-%s: health %s (probe exit %s, HTTP %s)\n' "$targetTag" "$label" "$probeCode" "$(< "$runtime/http-code")"
    fi
    if [[ $applied != "$state" ]] || (( SECONDS-lastSync >= dnsRefresh )); then
        if pool "$state"; then
            applied=$state; lastSync=$SECONDS
            printf 'spdu-%s: DNS state %s applied\n' "$targetTag" "$label"
        else
            applied=-1
            printf 'spdu-%s: ERROR: DNS update failed; retry pending\n' "$targetTag" >&2
        fi
    fi
    if [[ $pendingMail == yes && $applied == "$state" ]] && (( SECONDS-lastMail >= mailInterval )); then
        if report "$state"; then pendingMail=no
        else printf 'spdu-%s: ERROR: notification failed; retry pending\n' "$targetTag" >&2; fi
        # Round the completion time up: SECONDS has whole-second precision.
        lastMail=$((SECONDS+1))
    fi
    run "${sleepCommand[@]}" "$loopWait"
done
